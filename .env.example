# --- Convex ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Convex Auth (set on the Convex deployment, not in Next.js) ---
# npx convex env set AUTH_GOOGLE_ID ...
# npx convex env set AUTH_GOOGLE_SECRET ...
# npx convex env set SITE_URL https://gotalkify.com

# --- Stripe (set on the Convex deployment) ---
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (set on the Convex deployment) ---
# Used for all transactional email AND the signup email-OTP verification.
# npx convex env set RESEND_API_KEY re_...
# npx convex env set EMAIL_FROM "GoTalkify <hello@gotalkify.com>"
# npx convex env set ADMIN_EMAIL admin@gotalkify.com
# (Without RESEND_API_KEY in dev, the signup OTP code is printed to the
#  `npx convex dev` console instead of being emailed.)

# --- Built-in classroom / TURN relay (set on the Convex deployment) ---
# Classes run peer-to-peer over WebRTC. STUN (free, built in) connects roughly
# 80-85% of people; the rest are behind symmetric NAT or a corporate firewall
# and need a TURN relay. Configure ONE of the three options below.
#
# 1. Cloudflare Realtime TURN (recommended — generous free tier)
#    npx convex env set CLOUDFLARE_TURN_KEY_ID ...
#    npx convex env set CLOUDFLARE_TURN_API_TOKEN ...
#
# 2. Self-hosted coturn with `use-auth-secret`
#    npx convex env set TURN_URLS "turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp"
#    npx convex env set TURN_STATIC_AUTH_SECRET ...
#
# 3. Static credentials (Metered, Twilio, …)
#    npx convex env set TURN_URLS "turn:relay.example.com:80"
#    npx convex env set TURN_USERNAME ...
#    npx convex env set TURN_CREDENTIAL ...

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://gotalkify.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY (set on the Convex deployment)
NEXT_PUBLIC_CRISP_WEBSITE_ID=
