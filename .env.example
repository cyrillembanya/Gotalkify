# --- Convex ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Convex Auth (set on the Convex deployment, not in Next.js) ---
# npx convex env set AUTH_GOOGLE_ID ...
# npx convex env set AUTH_GOOGLE_SECRET ...
# npx convex env set SITE_URL https://gotalkify.com

# --- Stripe (set on the Convex deployment) ---
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (set on the Convex deployment) ---
# Used for all transactional email AND the signup email-OTP verification.
# npx convex env set RESEND_API_KEY re_...
# npx convex env set EMAIL_FROM "GoTalkify <hello@gotalkify.com>"
# npx convex env set ADMIN_EMAIL admin@gotalkify.com
# (Without RESEND_API_KEY in dev, the signup OTP code is printed to the
#  `npx convex dev` console instead of being emailed.)

# --- Google Meet (set on the Convex deployment) ---
# GOOGLE_SERVICE_ACCOUNT_JSON (full JSON string), GOOGLE_MEET_ORGANIZER_EMAIL

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://gotalkify.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY (set on the Convex deployment)
NEXT_PUBLIC_CRISP_WEBSITE_ID=
